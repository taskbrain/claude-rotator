#!/bin/sh
# Test-only stand-in for the real Codex CLI. Records the call and fails so a
# test that reaches a real codex through PATH cannot silently succeed.
log=${CLAUDE_ROTATOR_SERVICE_COMMAND_LOG:-${TMPDIR:-/tmp}/claude-rotator-service-command-guard.log}
printf 'codex %s\n' "$*" >>"$log" 2>/dev/null
printf 'refused: the test suite must not run the real codex\n' >&2
exit 1
